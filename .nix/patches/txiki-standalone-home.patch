     await exef.read(tpkMagicBuf, exeSize - TpkTrailer.MagicSize);
 
     if (decoder.decode(tpkMagicBuf) === TpkTrailer.Magic) {
+        ensureTjsHome();
         await runTpk(exef, exeSize);
 
         return true;
@@ -199,6 +203,7 @@ const isBundled = await (async () => {
 })();
 
